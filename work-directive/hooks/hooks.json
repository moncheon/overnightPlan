{
  "hooks": {
    "SessionStart": [
      {
        "description": "Check for active work directive and prompt resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-directive.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "description": "Save work directive state before session ends",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/save-session-state.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "description": "Track tool usage for progress estimation",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/track-tool-usage.sh"
          }
        ]
      }
    ]
  }
}
